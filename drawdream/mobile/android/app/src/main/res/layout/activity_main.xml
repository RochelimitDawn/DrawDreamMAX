<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_bg_light">

    <View
        android:id="@+id/gridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.95"
        android:background="@drawable/grid_overlay_light" />

    <View
        android:id="@+id/gridFadeMask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/grid_fade_mask_light" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="48dp"
            android:paddingEnd="24dp"
            android:paddingBottom="48dp">

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="@string/app_name"
                 android:src="@drawable/logo_mark_transparent" />

            <TextView
                android:id="@+id/splashTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/smiley_sans_oblique"
                android:letterSpacing="0.04"
                android:text="@string/app_name"
                android:textColor="#8B5124"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/splashTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/smiley_sans_oblique"
                android:text="@string/splash_tagline"
                android:textColor="#8A7660"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/splashProgress"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="20dp"
                android:indeterminate="true"
                android:indeterminateTint="#C47A3A" />

            <TextView
                android:id="@+id/statusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/smiley_sans_oblique"
                android:gravity="center"
                android:text="@string/status_preparing"
                android:textColor="#9A8874"
                android:textSize="12sp" />

            <!-- Uiverse-style terminal console -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="18dp"
                android:layout_weight="3"
                android:background="@drawable/terminal_bg"
                android:elevation="10dp"
                android:maxHeight="280dp"
                android:minHeight="200dp"
                android:orientation="vertical"
                android:clipToOutline="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:background="@drawable/terminal_toolbar_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <View
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/traffic_red" />

                    <View
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/traffic_yellow" />

                    <View
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/traffic_green" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="@string/splash_log_title"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#3A3A3A"
                        android:fontFamily="monospace"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="@string/splash_log_tab"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/logScroller"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fadeScrollbars="false"
                    android:fillViewport="false"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:id="@+id/splashLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/splashFooter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/smiley_sans_oblique"
                android:text="@string/splash_footer"
                android:textColor="#B8A894"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
