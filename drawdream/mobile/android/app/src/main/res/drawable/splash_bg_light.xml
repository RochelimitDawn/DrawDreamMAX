<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 浅色：暖羊皮纸底 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FAF6F0" />
        </shape>
    </item>
    <!-- 顶部暖金光晕 wash -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#EED9BC"
                android:centerColor="#F7EDE0"
                android:endColor="#FAF6F0"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
