<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- base slate -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F8FAFC" />
        </shape>
    </item>
    <!-- soft top wash -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#E8EEF7"
                android:centerColor="#F1F5F9"
                android:endColor="#F8FAFC"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
