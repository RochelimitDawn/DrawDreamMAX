<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 深色：暖炭棕底 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#161210" />
        </shape>
    </item>
    <!-- 顶部暖金微光 wash -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#4A3824"
                android:centerColor="#241D15"
                android:endColor="#161210"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
