#!/usr/bin/env bash
# Minimal Gradle wrapper bootstrap (full wrapper jar generated by `gradle wrapper` if available).
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
GRADLE_VERSION="${GRADLE_VERSION:-8.11.1}"
WRAPPER_JAR="$DIR/gradle/wrapper/gradle-wrapper.jar"

if [[ ! -f "$WRAPPER_JAR" ]]; then
  if command -v gradle >/dev/null 2>&1; then
    (cd "$DIR" && gradle wrapper --gradle-version "$GRADLE_VERSION")
  else
    echo "gradle-wrapper.jar missing and system gradle not found." >&2
    echo "Install Android Studio / Gradle, or run CI which installs SDK + generates wrapper." >&2
    exit 1
  fi
fi

exec java -jar "$WRAPPER_JAR" "$@"
